#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

BINARY="/usr/bin/openlist"
CONF_DIR="/etc/openlist"
CONF_FILE="$CONF_DIR/config.json"
LOG_FILE="$CONF_DIR/log/log.log"
CONFIG_UPDATER="/usr/share/oplist/update-config.uc"

update_config() {
    local tmp_file="$CONF_FILE.tmp.$$"
    local tmp_err="$CONF_FILE.tmp.$$.err"

    # Keep stderr (ucode warn()/die() messages) in a separate file: mixing it
    # into stdout would corrupt the JSON on successful runs with warnings.
    if ! ucode "$CONFIG_UPDATER" "$CONF_FILE" >"$tmp_file" 2>"$tmp_err"; then
        logger -t oplist "failed to update $CONF_FILE: $(cat "$tmp_err")"
        rm -f "$tmp_file" "$tmp_err"
        return 1
    fi
    rm -f "$tmp_err"

    chmod 600 "$tmp_file" || {
        rm -f "$tmp_file"
        return 1
    }
    mv -f "$tmp_file" "$CONF_FILE"
}

start_service() {
    config_load oplist
    local enabled
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 0 ] && return

    mkdir -p "$CONF_DIR" "$CONF_DIR/log"

    # Logs may contain sensitive data.
    touch "$LOG_FILE" 2>/dev/null
    chmod 600 "$LOG_FILE" 2>/dev/null

    if [ ! -x "$BINARY" ]; then
        logger -t oplist "openlist binary not found: $BINARY"
        return 1
    fi

    if [ ! -f "$CONF_FILE" ]; then
        (umask 077; printf '{}\n' > "$CONF_FILE") || return 1
    fi

    update_config || return 1

    procd_open_instance "instance1"
    # procd can only forward stdout/stderr to syslog, so wrap the command to
    # keep the service output in the same log file the LuCI log page reads.
    procd_set_param command /bin/sh -c \
        'exec "$1" server --data "$2" >>"$3" 2>&1' sh \
        "$BINARY" "$CONF_DIR" "$LOG_FILE"
    procd_set_param respawn
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "oplist"
}

reload_service() {
    stop
    start
}
