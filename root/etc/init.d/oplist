#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

BINARY="/usr/bin/openlist"
CONF_DIR="/etc/openlist"
CONF_FILE="$CONF_DIR/config.json"
LOG_FILE="$CONF_DIR/log/log.log"
CONFIG_UPDATER="/usr/share/oplist/update-config.uc"

# Returns 0 while the given PID is still running. On busybox ash a dead
# background child is not always reaped immediately, so also treat a
# zombie (/proc state "Z") as gone.
process_alive() {
    kill -0 "$1" 2>/dev/null || return 1
    if [ -r "/proc/$1/stat" ]; then
        [ "$(awk '{print $3}' "/proc/$1/stat" 2>/dev/null)" = "Z" ] && return 1
    fi
    return 0
}

update_config() {
    local tmp_file="$CONF_FILE.tmp.$$"

    if ! ucode "$CONFIG_UPDATER" "$CONF_FILE" >"$tmp_file"; then
        logger -t oplist "failed to update $CONF_FILE"
        rm -f "$tmp_file"
        return 1
    fi

    chmod 600 "$tmp_file" || {
        rm -f "$tmp_file"
        return 1
    }
    mv -f "$tmp_file" "$CONF_FILE"
}

start_service() {
    config_load oplist
    local enabled
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 0 ] && return

    mkdir -p "$CONF_DIR" "$CONF_DIR/log"

    if [ ! -x "$BINARY" ]; then
        logger -t oplist "openlist binary not found: $BINARY"
        return 1
    fi

    if [ ! -f "$CONF_FILE" ]; then
        # Bootstrap config generation. Keep stdout/stderr in the same log file
        # the LuCI log page reads, so the one-time admin password and any
        # startup errors are not lost.
        "$BINARY" server --data "$CONF_DIR" >>"$LOG_FILE" 2>&1 &
        local pid=$!
        local wait=0
        # Bail out early if the process exits before the config file appears,
        # instead of waiting out the full timeout on a failed bootstrap.
        while [ ! -f "$CONF_FILE" ] && [ $wait -lt 10 ] && process_alive "$pid"; do
            sleep 1
            wait=$((wait + 1))
        done
        kill "$pid" 2>/dev/null
        local kill_wait=0
        while kill -0 "$pid" 2>/dev/null && [ $kill_wait -lt 10 ]; do
            sleep 1
            kill_wait=$((kill_wait + 1))
        done
        # Escalate if it ignored SIGTERM, then wait for reaping either way.
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null

        if [ ! -f "$CONF_FILE" ]; then
            logger -t oplist "bootstrap failed: $CONF_FILE was not created"
            return 1
        fi
    fi

    update_config || return 1

    procd_open_instance "instance1"
    # procd can only forward stdout/stderr to syslog, so wrap the command to
    # keep the service output in the same log file the LuCI log page reads.
    procd_set_param command /bin/sh -c \
        'exec "$1" server --data "$2" >>"$3" 2>&1' sh \
        "$BINARY" "$CONF_DIR" "$LOG_FILE"
    procd_set_param respawn
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "oplist"
}

reload_service() {
    stop
    start
}
